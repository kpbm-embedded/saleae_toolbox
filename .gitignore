/config/local-licence.txt
/config/pins.local.tsv
*.AppImage
*.AppImage.part
*.part
*.sal
*.tar.zst
*.tar.gz
*.tgz
__pycache__/
*.pyc
.pytest_cache/
.zig-cache/
zig-out/
/target/
*.log
